---
import type { ExperienceItem } from '@/data/experience';

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props;
---

<article class="reveal glass-card relative p-6 sm:p-8">
  <div class="absolute left-0 top-8 h-[calc(100%-4rem)] w-1 rounded-full bg-gradient-to-b from-primary-500 to-accent opacity-60" />

  <div class="pl-4">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <span class="inline-block rounded-full bg-primary-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">
          {item.type === 'work' ? 'Work' : 'Organization'}
        </span>
        <h3 class="mt-2 font-display text-xl font-semibold text-slate-900 dark:text-white">
          {item.title}
        </h3>
        <p class="mt-1 text-sm font-medium text-primary-600 dark:text-primary-400">
          {item.company}
        </p>
      </div>
      <time class="shrink-0 rounded-lg border border-slate-200/80 bg-white/50 px-3 py-1.5 text-xs font-medium text-slate-600 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
        {item.period}
      </time>
    </div>

    {
      item.techStack && (
        <div class="mt-4 flex flex-wrap gap-2">
          {
            item.techStack.map((tech) => (
              <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                {tech}
              </span>
            ))
          }
        </div>
      )
    }

    <ul class="mt-4 space-y-2">
      {
        item.description.map((point) => (
          <li class="flex gap-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
            {point}
          </li>
        ))
      }
    </ul>
  </div>
</article>
