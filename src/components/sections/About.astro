---
import { about } from '@/data/site';
import SectionHeading from '../SectionHeading.astro';
---

<section id="about" class="py-20 sm:py-28">
  <div class="section-container">
    <SectionHeading title="About Me" subtitle="Get to know me better" />

    <div class="grid items-start gap-10 lg:grid-cols-5 lg:gap-16">
      <div class="reveal lg:col-span-3">
        <p class="text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
          {about.summary}
        </p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            about.highlights.map((item) => (
              <li class="flex items-center gap-3 rounded-xl border border-slate-200/60 bg-white/40 px-4 py-3 text-sm font-medium text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
                <span class="flex h-2 w-2 shrink-0 rounded-full bg-primary-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal lg:col-span-2">
        <div class="glass-card p-6 sm:p-8">
          <h3 class="font-display text-lg font-semibold text-slate-900 dark:text-white">
            Education
          </h3>
          <div class="mt-4 space-y-1">
            <p class="font-medium text-primary-600 dark:text-primary-400">{about.education.degree}</p>
            <p class="text-sm text-slate-700 dark:text-slate-300">{about.education.school}</p>
            <p class="text-sm text-slate-500">{about.education.location}</p>
            <time class="inline-block rounded-md bg-primary-500/10 px-2 py-1 text-xs font-semibold text-primary-700 dark:text-primary-300">
              {about.education.period}
            </time>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {about.education.details}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
