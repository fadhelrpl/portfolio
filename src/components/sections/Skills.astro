---
import { skillCategories } from '@/data/skills';
import SectionHeading from '../SectionHeading.astro';
---

<section id="skills" class="py-20 sm:py-28">
  <div class="section-container">
    <SectionHeading title="Skills" subtitle="Technologies and tools I work with" />

    <div class="grid gap-6 sm:grid-cols-2">
      {
        skillCategories.map((category) => (
          <div class="reveal glass-card p-6 sm:p-8">
            <h3 class="font-display text-lg font-semibold text-slate-900 dark:text-white">
              {category.name}
            </h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span class="rounded-xl border border-slate-200/60 bg-white/50 px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-primary-400/50 hover:bg-primary-500/10 hover:text-primary-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:hover:text-primary-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
