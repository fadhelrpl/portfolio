---
import { site } from '@/data/site';
import SocialLinks from '../SocialLinks.astro';
---

<section id="home" class="relative flex min-h-screen items-center pt-24">
  <div class="pointer-events-none absolute inset-0 bg-mesh" aria-hidden="true" />
  <div class="pointer-events-none absolute -left-32 top-20 h-72 w-72 rounded-full bg-primary-500/20 blur-3xl animate-pulse-soft" aria-hidden="true" />
  <div class="pointer-events-none absolute -right-32 bottom-20 h-72 w-72 rounded-full bg-accent/20 blur-3xl animate-pulse-soft" aria-hidden="true" />

  <div class="section-container relative z-10 py-16 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="order-2 text-center lg:order-1 lg:text-left">
        <p class="animate-fade-in text-sm font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400">
          Hello, I'm
        </p>
        <h1 class="animate-fade-in-up mt-3 font-display text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white" style="animation-delay: 0.1s">
          {site.name}
        </h1>
        <p class="animate-fade-in-up mt-4 font-display text-xl font-medium gradient-text sm:text-2xl" style="animation-delay: 0.2s">
          {site.role}
        </p>
        <p class="animate-fade-in-up mx-auto mt-6 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg lg:mx-0 dark:text-slate-400" style="animation-delay: 0.3s">
          {site.description}
        </p>

        <div class="animate-fade-in-up mt-8 flex flex-col items-center gap-4 sm:flex-row lg:justify-start" style="animation-delay: 0.4s">
          <a href="#contact" class="btn-primary w-full sm:w-auto">
            Get In Touch
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href={site.cvPath} download class="btn-outline w-full sm:w-auto">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Download CV
          </a>
        </div>

        <div class="animate-fade-in-up mt-8 flex justify-center lg:justify-start" style="animation-delay: 0.5s">
          <SocialLinks />
        </div>
      </div>

      <div class="order-1 flex justify-center lg:order-2">
        <div class="relative animate-float">
          <div class="absolute -inset-4 rounded-full bg-gradient-to-br from-primary-500/30 to-accent/30 blur-2xl" aria-hidden="true" />
          <div class="glass-card relative overflow-hidden rounded-3xl p-2">
            <img
              src="/images/profile.png"
              alt={`Portrait of ${site.name}`}
              class="relative h-64 w-64 rounded-2xl object-cover object-top sm:h-80 sm:w-80 lg:h-96 lg:w-96"
              width="384"
              height="384"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
