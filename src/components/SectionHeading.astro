---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`reveal mb-12 ${alignClass}`}>
  <h2 class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-3 text-base text-slate-600 dark:text-slate-400">{subtitle}</p>
    )
  }
  <div class={`mt-4 h-1 w-16 rounded-full bg-gradient-to-r from-primary-500 to-accent ${align === 'center' ? 'mx-auto' : ''}`} />
</div>
